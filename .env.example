# Copia in `.env` solo in locale. Nessun segreto vero in questo file.
# Tutte le variabili del prototipo hanno il prefisso MOSAIKA_.

# PostgreSQL del prototipo
MOSAIKA_DATABASE_URL=postgresql+psycopg://mosaika:mosaika@localhost:5432/mosaika

# Cookie di sessione. Cambiarlo fuori dalla macchina di sviluppo.
MOSAIKA_SESSION_SECRET=dev-session-secret-change-me
MOSAIKA_SESSION_DAYS=14
MOSAIKA_COOKIE_SECURE=false

# Password iniziale degli utenti seed (solo al primo avvio, se la tabella è vuota).
MOSAIKA_SEED_PASSWORD=mosaika-dev
MOSAIKA_PASSWORD_ITERATIONS=120000

# Fonte lead: mock (fixture, default) oppure xmlrpc (Odoo 18, sola lettura).
MOSAIKA_ODOO_SOURCE=mock
# L'URL di sviluppo deve contenere esconnect18-test. Esempio, da completare con l'host vero:
# MOSAIKA_ODOO_URL=https://esconnect18-test.example
MOSAIKA_ODOO_URL=
MOSAIKA_ODOO_DB=
MOSAIKA_ODOO_USERNAME=
MOSAIKA_ODOO_PASSWORD=
# Lettura della produzione: resta false finché Renato non dà il consenso esplicito.
MOSAIKA_ODOO_ALLOW_PRODUCTION=false
MOSAIKA_ODOO_TEST_MARKER=esconnect18-test

# Assistente. mock non chiama la rete e usa solo le risposte validate.
# openai: endpoint compatibile con le API chat (serve MOSAIKA_AI_API_KEY).
MOSAIKA_AI_PROVIDER=mock
MOSAIKA_AI_API_KEY=
MOSAIKA_AI_BASE_URL=https://api.openai.com/v1
MOSAIKA_AI_MODEL=gpt-4o-mini

# Rilettura della fonte, in secondi (il brief: ogni 10 minuti).
MOSAIKA_SYNC_INTERVAL_SECONDS=600
